@model AirPulse.Models.AirQualityView
@{
    ViewData["Title"] = "Luchtkwaliteit";
}

<div class="container py-4">
    <!-- Header & Dropdown -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="h2 mb-0">Luchtkwaliteit: @Model.SelectedCity</h1>
        </div>
        <div class="col-md-6">
            <form method="get" asp-controller="Home" asp-action="Index" class="d-flex gap-2 justify-content-md-end">
                <select name="city" class="form-select w-auto" onchange="this.form.submit()">
                    @foreach (var cityOption in Model.AvailableCities)
                    {
                        <option value="@cityOption.Value" selected="@(cityOption.Selected ? "selected" : null)">
                            @cityOption.Text
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Verversen</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.CurrentAirQuality?.Current != null)
    {
        var current = Model.CurrentAirQuality.Current;

        <!-- Grote AQI Badge Card -->
        <div class="card border-0">
            <div class="card-body text-center">
                <p class="text-uppercase fw-bold mb-1">Actuele Luchtkwaliteit Index</p>
                
                <!-- Grote getalweergave met dynamische kleur -->
                <div class="display-1 fw-bold text-@current.AqiBadgeClass my-1">
                    @(current.EuropeanAqi?.ToString("0") ?? "-")
                </div>
                
                <!-- Badge met de status -->
                <div>
                    <span class="badge bg-@current.AqiBadgeClass fs-5 px-3 py-2">
                        @current.AqiCategory
                    </span>
                </div>
                
                <small class="text-muted d-block mt-3">
                    Laatste meting: @current.FormattedTime (lokale tijd)
                </small>
            </div>
        </div>

        <div class="card-grid">
            <div class="card p-3">
                <h5>PM 2.5</h5>
                <p class="mb-0">Waarde: @(current.Pm25?.ToString("0.0") ?? "-") µg/m³</p>
                <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-@current.GetPollutantColor(current.Pm25, 25)" 
                    role="progressbar" style="width: @current.GetPercentage(current.Pm25, 25)%">
            </div>
            </div>
            </div>

            <div class="card p-3">
                <h5>PM 10</h5>
                <p class="mb-0">Waarde: @(current.Pm10?.ToString("0.0") ?? "-") µg/m³</p>
                <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-@current.GetPollutantColor(current.Pm10, 50)" 
                    role="progressbar" style="width: @current.GetPercentage(current.Pm10, 50)%">
            </div>
            </div>
            </div>
            <div class="card p-3">
                <h5>NO₂</h5>
                <p class="mb-0">Waarde: @(current.NitrogenDioxide?.ToString("0.0") ?? "-") µg/m³</p>
                <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-@current.GetPollutantColor(current.NitrogenDioxide, 90)" 
                    role="progressbar" style="width: @current.GetPercentage(current.NitrogenDioxide, 90)%">
            </div>
            </div>
            </div>
        </div>
    }
   <!-- Grafiek Card met Dropdown Filter -->
<div class="card p-3 mt-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">Verloop Luchtkwaliteit (@Model.SelectedCity)</h5>
        
        <div>
            <select id="timeRangeFilter" class="form-select form-select-sm" style="width: auto;">
                <option value="today">Vandaag</option>
                <option value="2days">Afgelopen 2 dagen</option>
                <option value="7days" selected>Afgelopen 7 dagen</option>
            </select>
        </div>
    </div>

    <div style="height: 320px; width: 100%;">
        <canvas id="airQualityChart"></canvas>
    </div>
</div>
    
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cityName = "@Model.SelectedCity";
            const ctx = document.getElementById('airQualityChart').getContext('2d');
            const filterDropdown = document.getElementById('timeRangeFilter');
            let chartInstance = null; // Bewaart de huidige grafiek zodat we die kunnen verversen

            // Functie die de juiste startdatum berekent op basis van de dropdown-keuze
            function buildApiUrl(range) {
                let url = `/api/air/${encodeURIComponent(cityName)}`;
                const now = new Date();
                let startDate = null;

                if (range === "today") {
                    // Vanaf 00:00 uur vandaag
                    startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                } else if (range === "2days") {
                    startDate = new Date(now.getTime() - (2 * 24 * 60 * 60 * 1000));
                } else if (range === "7days") {
                    startDate = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
                }

                return url;
            }

            // Functie om data op te halen en de grafiek te tekenen/updaten
            async function loadChartData() {
                const selectedRange = filterDropdown.value;
                const apiUrl = buildApiUrl(selectedRange);

                try {
                    const response = await fetch(apiUrl);
                    if (!response.ok) return;

                    const data = await response.json();
                    const samples = data.samples || [];

                    const labels = samples.map(s => s.time);
                    const aqiData = samples.map(s => s.aqi);
                    const pm25Data = samples.map(s => s.pm25 != null ? Math.round((s.pm25 / 25) * 100) : null);
                    const pm10Data = samples.map(s => s.pm10 != null ? Math.round((s.pm10 / 50) * 100) : null);
                    const no2Data = samples.map(s => s.no2 != null ? Math.round((s.no2 / 90) * 100) : null);
                    const yAxisLabel = 'Percentage van limiet (%) / Index';

                    // Ruimt de oude grafiek eerst op voordat we een nieuwe tekenen
                    if (chartInstance) {
                        chartInstance.destroy();
                    }

                    chartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: 'European AQI',
                                    data: aqiData,
                                    borderColor: '#0dcaf0',
                                    backgroundColor: 'rgba(13, 202, 240, 0.1)',
                                    tension: 0.3,
                                    fill: false
                                },
                                {
                                    label: 'PM 2.5 (µg/m³)',
                                    data: pm25Data,
                                    borderColor: '#ffc107',
                                    tension: 0.3,
                                    fill: false
                                },
                                {
                                    label: 'PM 10 (µg/m³)',
                                    data: pm10Data,
                                    borderColor: '#fd7e14',
                                    tension: 0.3,
                                    fill: false
                                },
                                {
                                    label: 'NO₂ (µg/m³)',
                                    data: no2Data,
                                    borderColor: '#dc3545',
                                    tension: 0.3,
                                    fill: false
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            scales: {
                                y: {beginAtZero: true, title: { display: true, text: yAxisLabel }
                                },
                                x: {
                                    title: { display: true, text: 'Tijdstip' }
                                }
                            }
                        }
                    });
                } catch (err) {
                    console.error("Fout bij ophalen grafiekdata:", err);
                }
            }

            // 1. Luister naar wijzigingen in het dropdown-menu
            filterDropdown.addEventListener("change", loadChartData);

            // 2. Laad direct bij het openen van de pagina
            loadChartData();
        });
    </script>
}