@model AirPulse.Models.CompareAirQualityViewModel
@{
    ViewData["Title"] = "Steden Vergelijken";
}

<div class="container py-4">
    <h1 class="h2 mb-4">Luchtkwaliteit Vergelijken</h1>

    <!-- Twee dropdowns naast elkaar -->
    <form method="get" asp-controller="Home" asp-action="Vergelijken" class="card p-3 shadow-sm mb-4 border-0">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold">Stad 1</label>
                <select name="cityA" class="form-select" onchange="this.form.submit()">
                    @foreach (var city in Model.AvailableCities)
                    {
                        <option value="@city.Value" selected="@(city.Value == Model.CityA ? "selected" : null)">
                            @city.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-5">
                <label class="form-label fw-bold">Stad 2</label>
                <select name="cityB" class="form-select" onchange="this.form.submit()">
                    @foreach (var city in Model.AvailableCities)
                    {
                        <option value="@city.Value" selected="@(city.Value == Model.CityB ? "selected" : null)">
                            @city.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Verversen</button>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.LatestCityA != null && Model.LatestCityB != null)
{
    <div class="alert alert-light border shadow-sm text-center mb-4">
        <span class="badge bg-success me-2">Conclusie</span>
        <strong>@Model.ComparisonSummary</strong>
    </div>
}
    <!-- Vergelijking in twee kolommen -->
    <div class="row g-4">
        <!-- Kolom Stad A -->
        <div class="col-md-6">
            <h3 class="h4 text-center mb-3">@Model.CityA</h3>
            @if (Model.LatestCityA != null)
            {
                var curA = Model.LatestCityA;
                
                <div class="card shadow-sm border-0 mb-3 text-center py-3">
                    <p class="text-uppercase text-muted fw-bold mb-1">Index</p>
                    <div class="display-3 fw-bold text-@curA.AqiBadgeClass">
                        @(curA.EuropeanAqi?.ToString("0") ?? "-")
                    </div>
                    <span class="badge bg-@curA.AqiBadgeClass fs-6 px-3 py-1 align-self-center mt-1">
                        @curA.AqiCategory
                    </span>
                    <small class="text-muted mt-2">Meting: @curA.FormattedTime</small>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>PM 2.5</span>
                        <strong>@(curA.Pm25?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curA.GetPollutantColor(curA.Pm25, 25)" style="width: @curA.GetPercentage(curA.Pm25, 25)%"></div>
                    </div>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>PM 10</span>
                        <strong>@(curA.Pm10?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curA.GetPollutantColor(curA.Pm10, 50)" style="width: @curA.GetPercentage(curA.Pm10, 50)%"></div>
                    </div>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>NO₂</span>
                        <strong>@(curA.NitrogenDioxide?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curA.GetPollutantColor(curA.NitrogenDioxide, 90)" style="width: @curA.GetPercentage(curA.NitrogenDioxide, 90)%"></div>
                    </div>
                </div>
            }
        </div>

        <!-- Kolom Stad B -->
        <div class="col-md-6">
            <h3 class="h4 text-center mb-3">@Model.CityB</h3>
            @if (Model.LatestCityB != null)
            {
                var curB = Model.LatestCityB;
                
                <div class="card shadow-sm border-0 mb-3 text-center py-3">
                    <p class="text-uppercase text-muted fw-bold mb-1">Index</p>
                    <div class="display-3 fw-bold text-@curB.AqiBadgeClass">
                        @(curB.EuropeanAqi?.ToString("0") ?? "-")
                    </div>
                    <span class="badge bg-@curB.AqiBadgeClass fs-6 px-3 py-1 align-self-center mt-1">
                        @curB.AqiCategory
                    </span>
                    <small class="text-muted mt-2">Meting: @curB.FormattedTime</small>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>PM 2.5</span>
                        <strong>@(curB.Pm25?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curB.GetPollutantColor(curB.Pm25, 25)" style="width: @curB.GetPercentage(curB.Pm25, 25)%"></div>
                    </div>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>PM 10</span>
                        <strong>@(curB.Pm10?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curB.GetPollutantColor(curB.Pm10, 50)" style="width: @curB.GetPercentage(curB.Pm10, 50)%"></div>
                    </div>
                </div>

                <div class="card p-3 shadow-sm border-0 mb-2">
                    <div class="d-flex justify-content-between">
                        <span>NO₂</span>
                        <strong>@(curB.NitrogenDioxide?.ToString("0.0") ?? "-") µg/m³</strong>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-@curB.GetPollutantColor(curB.NitrogenDioxide, 90)" style="width: @curB.GetPercentage(curB.NitrogenDioxide, 90)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Vergelijkingsgrafiek met twee lijnen (Opdracht 3) -->
    @if (Model.HistoryCityA.Any() || Model.HistoryCityB.Any())
    {
        <div class="card p-3 mt-4 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">AQI Verloop: @Model.CityA vs. @Model.CityB</h5>
                <select id="compareTimeFilter" class="form-select form-select-sm" style="width: auto;">
                    <option value="today">Vandaag</option>
                    <option value="2days">Afgelopen 2 dagen</option>
                    <option value="7days" selected>Afgelopen 7 dagen</option>
                </select>
            </div>

            <div style="height: 320px; width: 100%;">
                <canvas id="compareChart"></canvas>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const samplesA = @Html.Raw(Json.Serialize(Model.HistoryCityA));
            const samplesB = @Html.Raw(Json.Serialize(Model.HistoryCityB));
            const cityAName = "@Model.CityA";
            const cityBName = "@Model.CityB";

            const canvas = document.getElementById('compareChart');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            const filterDropdown = document.getElementById('compareTimeFilter');
            let chartInstance = null;

            function filterByRange(samples, range) {
                const now = new Date();
                let cutoff = null;

                if (range === "today") {
                    cutoff = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                } else if (range === "2days") {
                    cutoff = new Date(now.getTime() - (2 * 24 * 60 * 60 * 1000));
                } else if (range === "7days") {
                    cutoff = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
                }

                if (!cutoff) return samples;
                return samples.filter(s => new Date(s.timestamp) >= cutoff);
            }

            function renderCompareChart() {
                const range = filterDropdown.value;
                const filteredA = filterByRange(samplesA, range);
                const filteredB = filterByRange(samplesB, range);

                // Gebruik de tijdstempels van Stad A (of B als A leeg is) voor de X-as
                const baseSeries = filteredA.length >= filteredB.length ? filteredA : filteredB;
                const labels = baseSeries.map(s => {
                    const d = new Date(s.timestamp);
                    return d.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit' }) + ' ' +
                           d.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' });
                });

                const dataA = filteredA.map(s => s.europeanAqi);
                const dataB = filteredB.map(s => s.europeanAqi);

                if (chartInstance) {
                    chartInstance.destroy();
                }

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: `${cityAName} (AQI)`,
                                data: dataA,
                                borderColor: '#0d6efd',
                                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                tension: 0.3,
                                fill: false
                            },
                            {
                                label: `${cityBName} (AQI)`,
                                data: dataB,
                                borderColor: '#dc3545',
                                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                                tension: 0.3,
                                fill: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'European AQI' }
                            },
                            x: {
                                title: { display: true, text: 'Tijdstip' }
                            }
                        }
                    }
                });
            }

            filterDropdown.addEventListener("change", renderCompareChart);
            renderCompareChart();
        });
    </script>
}