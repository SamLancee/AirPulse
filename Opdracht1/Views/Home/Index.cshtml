@model AirPulse.Models.AirQualityView
@{
    ViewData["Title"] = "Luchtkwaliteit";
}

<div class="container py-4">
    <!-- Header & Dropdown -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="h2 mb-0">Luchtkwaliteit: @Model.SelectedCity</h1>
        </div>
        <div class="col-md-6">
            <form method="get" asp-controller="Home" asp-action="Index" class="d-flex gap-2 justify-content-md-end">
                <select name="city" class="form-select w-auto" onchange="this.form.submit()">
                    @foreach (var cityOption in Model.AvailableCities)
                    {
                        <option value="@cityOption.Value" selected="@(cityOption.Selected ? "selected" : null)">
                            @cityOption.Text
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Verversen</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.LatestSample != null)
    {
        var current = Model.LatestSample;

        <!-- Grote AQI Badge Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body text-center">
                <p class="text-uppercase fw-bold mb-1">Actuele Luchtkwaliteit Index</p>
                
                <!-- Grote getalweergave met dynamische kleur -->
                <div class="display-1 fw-bold text-@current.AqiBadgeClass my-1">
                    @(current.EuropeanAqi?.ToString("0") ?? "-")
                </div>
                
                <!-- Badge met de status -->
                <div>
                    <span class="badge bg-@current.AqiBadgeClass fs-5 px-3 py-2">
                        @current.AqiCategory
                    </span>
                </div>
                
               
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <h5>PM 2.5</h5>
                    <p class="mb-2">Waarde: @(current.Pm25?.ToString("0.0") ?? "-") µg/m³</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-@current.GetPollutantColor(current.Pm25, 25)" 
                             role="progressbar" style="width: @current.GetPercentage(current.Pm25, 25)%">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <h5>PM 10</h5>
                    <p class="mb-2">Waarde: @(current.Pm10?.ToString("0.0") ?? "-") µg/m³</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-@current.GetPollutantColor(current.Pm10, 50)" 
                             role="progressbar" style="width: @current.GetPercentage(current.Pm10, 50)%">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <h5>NO₂</h5>
                    <p class="mb-2">Waarde: @(current.NitrogenDioxide?.ToString("0.0") ?? "-") µg/m³</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-@current.GetPollutantColor(current.NitrogenDioxide, 90)" 
                             role="progressbar" style="width: @current.GetPercentage(current.NitrogenDioxide, 90)%">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grafiek Card met Dropdown Filter -->
        <div class="card p-3 mt-4 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Verloop Luchtkwaliteit (@Model.SelectedCity)</h5>
                
                <div>
                    <select id="timeRangeFilter" class="form-select form-select-sm" style="width: auto;">
                        <option value="today">Vandaag</option>
                        <option value="2days">Afgelopen 2 dagen</option>
                        <option value="7days" selected>Afgelopen 7 dagen</option>
                        <option value="forecast">Voorspelling</option>
                    </select>
                </div>
            </div>

            <div style="height: 320px; width: 100%;">
                <canvas id="airQualityChart"></canvas>
            </div>

            <!-- Periode-stats onder de grafiek -->
            <div class="row text-center mt-3 pt-3 border-top">
                <div class="col-4">
                    <small class="text-muted d-block">Min. AQI</small>
                    <strong id="statMin">-</strong>
                </div>
                <div class="col-4">
                    <small class="text-muted d-block">Gemiddelde AQI</small>
                    <strong id="statAvg">-</strong>
                </div>
                <div class="col-4">
                    <small class="text-muted d-block">Max. AQI</small>
                    <strong id="statMax">-</strong>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const allSamples = @Html.Raw(Json.Serialize(Model.HistorySamples));
            const canvas = document.getElementById('airQualityChart');
            if (!canvas || !allSamples || allSamples.length === 0) return;

            const ctx = canvas.getContext('2d');
            const filterDropdown = document.getElementById('timeRangeFilter');
            let chartInstance = null;

            function filterSamples(range) {
            const now = new Date();

            if (range === "forecast") {
                // Alleen toekomstige forecast-records tonen (vanaf nu vooruit)
                return allSamples.filter(s => s.isForecast && new Date(s.timestamp) >= now);
            }

            let cutoff = null;
            if (range === "today") {
                cutoff = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            } else if (range === "2days") {
                cutoff = new Date(now.getTime() - (2 * 24 * 60 * 60 * 1000));
            } else if (range === "7days") {
                cutoff = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
            }

            // Voor Vandaag / Afgelopen 2 dagen / Afgelopen 7 dagen:
            // Stop bij 'now' zodat de toekomstige 3 dagen er niet meer achteraan geplakt worden.
            // (Bewaarde forecasts uit het verleden tussen cutoff en now blijven wel meedoen voor de vergelijking)
            return allSamples.filter(s => {
                const sampleDate = new Date(s.timestamp);
                if (cutoff && sampleDate < cutoff) return false;
                return sampleDate <= now;
            });
        }

            function updateStats(actualSamples) {
                const aqiValues = actualSamples.map(s => s.europeanAqi).filter(v => v != null);
                if (aqiValues.length === 0) {
                    document.getElementById('statMin').textContent = "-";
                    document.getElementById('statAvg').textContent = "-";
                    document.getElementById('statMax').textContent = "-";
                    return;
                }

                const min = Math.min(...aqiValues);
                const max = Math.max(...aqiValues);
                const avg = (aqiValues.reduce((a, b) => a + b, 0) / aqiValues.length).toFixed(1);

                document.getElementById('statMin').textContent = min;
                document.getElementById('statAvg').textContent = avg;
                document.getElementById('statMax').textContent = max;
            }

            function getHourKey(timestampStr) {
                const d = new Date(timestampStr);
                const pad = n => String(n).padStart(2, '0');
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:00`;
            }
            
            function renderChart() {
                const selectedRange = filterDropdown.value;
                const filtered = filterSamples(selectedRange);

                const actualMap = new Map();
                const forecastMap = new Map();

                filtered.forEach(s => {
                    const key = getHourKey(s.timestamp);
                    if (s.isForecast) {
                        forecastMap.set(key, s);
                    } else {
                        actualMap.set(key, s);
                    }
                });

                const statsSource = selectedRange === "forecast" 
                ? Array.from(forecastMap.values()) 
                : Array.from(actualMap.values());
                updateStats(statsSource);

                // Alle unieke uren (zowel verleden met dubbele data als toekomst) chronologisch sorteren
                const allKeys = Array.from(new Set([...actualMap.keys(), ...forecastMap.keys()])).sort();

                const labels = allKeys.map(key => {
                    // Maak van "2026-11-23 14:00" netjes "23-11 14:00"
                    const [datePart, timePart] = key.split(' ');
                    const [, month, day] = datePart.split('-');
                    return `${day}-${month} ${timePart}`;
                });

                const actualAqiData = allKeys.map(k => actualMap.get(k)?.europeanAqi ?? null);
                const forecastAqiData = allKeys.map(k => forecastMap.get(k)?.europeanAqi ?? null);

                const pm25Data = allKeys.map(k => {
                    const s = actualMap.get(k);
                    return s?.pm25 != null ? Math.round((s.pm25 / 25) * 100) : null;
                });
                const pm10Data = allKeys.map(k => {
                    const s = actualMap.get(k);
                    return s?.pm10 != null ? Math.round((s.pm10 / 50) * 100) : null;
                });
                const no2Data = allKeys.map(k => {
                    const s = actualMap.get(k);
                    return s?.nitrogenDioxide != null ? Math.round((s.nitrogenDioxide / 90) * 100) : null;
                });

                if (chartInstance) {
                    chartInstance.destroy();
                }

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'European AQI (Werkelijk)',
                                data: actualAqiData,
                                borderColor: '#0dcaf0',
                                backgroundColor: 'rgba(13, 202, 240, 0.1)',
                                tension: 0.3,
                                fill: false,
                                spanGaps: false
                            },
                            {
                                label: 'European AQI (Forecast)',
                                data: forecastAqiData,
                                borderColor: '#6f42c1',
                                backgroundColor: 'rgba(111, 66, 193, 0.1)',
                                borderDash: [6, 4], // Stippellijn voor de voorspelling
                                tension: 0.3,
                                fill: false,
                                spanGaps: false
                            },
                            {
                                label: 'PM 2.5 (% limiet)',
                                data: pm25Data,
                                borderColor: '#ffc107',
                                tension: 0.3,
                                fill: false
                            },
                            {
                                label: 'PM 10 (% limiet)',
                                data: pm10Data,
                                borderColor: '#fd7e14',
                                tension: 0.3,
                                fill: false
                            },
                            {
                                label: 'NO₂ (% limiet)',
                                data: no2Data,
                                borderColor: '#dc3545',
                                tension: 0.3,
                                fill: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Percentage van limiet (%) / Index' }
                            },
                            x: {
                                title: { display: true, text: 'Tijdstip' }
                            }
                        }
                    }
                });
            }

            filterDropdown.addEventListener("change", renderChart);
            renderChart();
        });
    </script>
}
